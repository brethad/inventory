# Copy to a private file named local-no-auth.env next to docker-compose.yml.
# Generate the two secrets on the machine that runs Docker. Do not commit them.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000
INVENTORY_IMAGE=inventory-local-no-auth:1.4.0
